      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "// This runs once for all items\nconst items = $input.all(); // array of all input items\nconst outputs = [];\n\nfor (const item of items) {\n  const raw = item.json.output;\n  let jsonString = raw;\n  const match = raw.match(/```json\\s*([\\s\\S]*?)```/);\n  if (match) {\n    jsonString = match[1];\n  } else {\n    const braceMatch = raw.match(/\\{[\\s\\S]*\\}/);\n    if (braceMatch) jsonString = braceMatch[0];\n  }\n  jsonString = jsonString.trim()\n    .replace(/,\\s*}/g, '}')\n    .replace(/,\\s*\\]/g, ']');\n\n  let parsed;\n  try {\n    parsed = JSON.parse(jsonString);\n  } catch (e) {\n    parsed = { error: 'Failed to parse JSON', raw: raw };\n  }\n\n  // Fix URL using the original snapshotUrl\n  const original = item.json;\n  parsed.url = original.snapshotUrl || parsed.url || '';\n\n  outputs.push({ json: parsed });\n}\n\nreturn outputs; // returns all 12 items"
      },

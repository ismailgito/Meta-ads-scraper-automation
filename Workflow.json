        "jsonBody": "{\n    \"countries\": [\n        \"india \"\n    ],\n    \"maxAds\": 7,\n    \"resolveSnapshotUrls\": false,\n    \"searchTerms\": [\n        \"Nike\",\n        \"puma\"\n    ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
